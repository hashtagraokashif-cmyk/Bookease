# Port the API listens on. Not 5000: on Macs, AirPlay Receiver uses that port.
PORT=5050

# Local MongoDB (default) or a MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/appointment_booking

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Optional: the deployed frontend's address (localhost is always allowed)
# CLIENT_URL=https://your-frontend.example.com

# Optional: timezone used for "today" and past-time checks
# APP_TIMEZONE=Asia/Karachi
